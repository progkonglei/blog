# Provider: deepseek | openai | anthropic | (auto)
AGENT_PROVIDER=deepseek

# DeepSeek (OpenAI-compatible)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Anthropic (optional)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# OpenAI / compatible gateway (optional)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Permission mode: default | acceptEdits | bypassPermissions
AGENT_PERMISSION_MODE=default

# 记录每次发给大模型的请求到本地文件（默认开启）
# 目录：.sessions/llm-logs/<sessionId>/
# AGENT_LLM_LOG=0              # 关闭
# AGENT_LLM_LOG_RESPONSE=0     # 只记请求、不记响应
# AGENT_LLM_LOG_DIR=/tmp/llm   # 自定义根目录

# 会话执行日志（用户输入 / 工具 / 输出轨迹，默认开启）
# 目录：.sessions/exec-logs/<sessionId>/{exec.jsonl,exec.log}
# AGENT_EXEC_LOG=0
# AGENT_EXEC_LOG_DIR=/tmp/exec

# Offline smoke tests
# MOCK_LLM=1
