# Provider: deepseek | openai | anthropic | (auto)
AGENT_PROVIDER=deepseek

# DeepSeek (OpenAI-compatible)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Anthropic (optional)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# OpenAI / compatible gateway (optional)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Permission mode: default | acceptEdits | bypassPermissions
AGENT_PERMISSION_MODE=default

# 会话执行日志（默认开启）— 流水线 + 每轮总结
# 目录：.sessions/exec-logs/<sessionId>/{flow.log,session-summary.md,turns/...}
# AGENT_EXEC_LOG=0
# AGENT_EXEC_LOG_DIR=/tmp/exec

# LLM 请求日志（默认开启）
# 目录：.sessions/llm-logs/<sessionId>/{NNNN-request,response,summary}
# AGENT_LLM_LOG=0
# AGENT_LLM_LOG_RESPONSE=0
# AGENT_LLM_LOG_DIR=/tmp/llm

# Offline smoke tests
# MOCK_LLM=1
